<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#F3F4F6"
    android:gravity="center">

    <TextView
        android:id="@+id/textBasvuruIlanBaslik"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#111827"
        android:textAlignment="center"
        android:layout_marginBottom="32dp"/>

    <Button
        android:id="@+id/btnPdfSec"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CV Dosyanızı (PDF) Seçin"
        android:backgroundTint="#3B82F6"
        android:textColor="#FFFFFF"
        android:padding="12dp"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/textSecilenDosya"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="#10B981"
        android:textAlignment="center"
        android:textStyle="italic"
        android:layout_marginBottom="32dp"/>

    <Button
        android:id="@+id/btnBasvuruyuTamamla"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Başvuruyu Yap ve AI Analizini Başlat"
        android:backgroundTint="#FF4D24"
        android:textColor="#FFFFFF"
        android:padding="16dp"
        android:textSize="16sp"/>
</LinearLayout>