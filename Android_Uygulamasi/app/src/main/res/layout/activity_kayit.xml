<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#F3F4F6">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Yeni Hesap Oluştur"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#111827"
        android:layout_marginBottom="30dp"/>

    <EditText
        android:id="@+id/editKayitEposta"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:hint="E-posta Adresiniz"
        android:inputType="textEmailAddress"
        android:background="#FFFFFF"
        android:padding="15dp"
        android:elevation="2dp"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/editKayitSifre"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:hint="Şifreniz"
        android:inputType="textPassword"
        android:background="#FFFFFF"
        android:padding="15dp"
        android:elevation="2dp"
        android:layout_marginBottom="16dp"/>

    <Spinner
        android:id="@+id/spinnerKullaniciTipi"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:layout_marginBottom="24dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="24dp">

        <TextView
            android:id="@+id/textMatematikSorusu"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="55dp"
            android:gravity="center_vertical"
            android:text="5 + 3 = ?"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#111827"/>

        <EditText
            android:id="@+id/editMatematikCevabi"
            android:layout_width="100dp"
            android:layout_height="55dp"
            android:hint="Cevap"
            android:inputType="number"
            android:background="#FFFFFF"
            android:padding="15dp"
            android:elevation="2dp"/>
    </LinearLayout>

    <Button
        android:id="@+id/btnKayitOl"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="KAYIT OL"
        android:textSize="16sp"
        android:backgroundTint="#FF4D24"
        android:textColor="#FFFFFF"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/textKayitMesaj"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:textSize="14sp"
        android:textColor="#FF3B57"
        android:textAlignment="center"/>

</LinearLayout>